      "type": "picklist",
      "pgType": "text",
      "description": "Unscheduled = created without a window (sits in the dispatch tray until dropped on the board; 2026-09-15). En Route = 'on my way' (texts the customer when notify is on; ends the previous call's clock and starts drive time on this one).",
      "gate": null,
      "reportable": true,
      "longText": false,
      "picklistValues": [
        "Unscheduled",
        "Scheduled",
        "En Route",
        "In Progress",
        "Complete",
        "Cancelled",
        "No-Show"
