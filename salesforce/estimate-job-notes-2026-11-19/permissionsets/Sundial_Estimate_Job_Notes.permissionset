<?xml version="1.0" encoding="UTF-8"?>
<!--
  Field permissions on the three job-notes fields of Sundial_Estimate__c (2026-11-19) for the Sundial
  INTEGRATION USER (assign to it after deploy). Object access on the estimate is already granted by
  Sundial_Service_Objects; this set adds only the three new fields.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Sundial Estimate Job Notes</label>
    <description>2026-11-19: field access on Sundial_Estimate__c.Issue_Description__c, Initial_Remote_Diagnosis__c and Office_Notes__c (job notes written on the estimate before its job exists) for the Sundial integration user.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Sundial_Estimate__c.Issue_Description__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Sundial_Estimate__c.Initial_Remote_Diagnosis__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Sundial_Estimate__c.Office_Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
