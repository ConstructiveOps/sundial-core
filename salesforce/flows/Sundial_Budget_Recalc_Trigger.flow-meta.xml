<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>After-save trigger on Sundial_Solar__c: when a budget INPUT field changes (and the change is NOT the budget Lambda's own writeback), set Budget_Calc_Status__c=Pending and publish Sundial_Budget_Recalc__e so the Lambda recalculates. All math lives in the Lambda. DRAFT: append Harmon milestone trigger fields (a third formula fInputChangedC) and Activate before go-live. Entry split across two formulas because 73 ISCHANGED terms exceed the ~3900-char single-formula limit.</description>
    <environments>Default</environments>
    <formulas>
        <name>fGuardNotWriteback</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISCHANGED({!$Record.Budget_Last_Calculated__c}))</expression>
    </formulas>
    <formulas>
        <name>fInputChangedA</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISCHANGED({!$Record.Project_Name__c}),
    ISCHANGED({!$Record.Contract_Amount__c}),
    ISCHANGED({!$Record.Dealer_Fee__c}),
    ISCHANGED({!$Record.System_Size__c}),
    ISCHANGED({!$Record.Module_STC_Wattage__c}),
    ISCHANGED({!$Record.Module_Cost_Per_Watt__c}),
    ISCHANGED({!$Record.Sales_Rep_Commission_PPW__c}),
    ISCHANGED({!$Record.Sales_Mgr_Commission_PPW__c}),
    ISCHANGED({!$Record.Geo_Commission_Amount__c}),
    ISCHANGED({!$Record.Overhead_Commission_PPW__c}),
    ISCHANGED({!$Record.Commission_Burden_Rate__c}),
    ISCHANGED({!$Record.Combiner_Unit_Cost__c}),
    ISCHANGED({!$Record.Combiner_Qty__c}),
    ISCHANGED({!$Record.Gateway_Unit_Cost__c}),
    ISCHANGED({!$Record.Gateway_Qty__c}),
    ISCHANGED({!$Record.Microinverter_Unit_Cost__c}),
    ISCHANGED({!$Record.Microinverter_Qty__c}),
    ISCHANGED({!$Record.Battery_Unit_Cost__c}),
    ISCHANGED({!$Record.Battery_Qty__c}),
    ISCHANGED({!$Record.BOS_Solar_Cost_Per_Watt__c}),
    ISCHANGED({!$Record.BOS_Electrical_Cost_Per_Watt__c}),
    ISCHANGED({!$Record.Roof_Material_Cost_Per_Pen__c}),
    ISCHANGED({!$Record.Penetrations_Per_Module__c}),
    ISCHANGED({!$Record.Blended_Labor_Rate__c}),
    ISCHANGED({!$Record.Labor_Burden_Rate__c}),
    ISCHANGED({!$Record.Audit_Hours__c}),
    ISCHANGED({!$Record.QA_Commissioning_Hours__c}),
    ISCHANGED({!$Record.Roofing_Cost_Per_Penetration__c}),
    ISCHANGED({!$Record.Roofing_Pens_Per_Module__c}),
    ISCHANGED({!$Record.Install_Hours_Per_Module__c}),
    ISCHANGED({!$Record.Battery_Labor_Rate__c}),
    ISCHANGED({!$Record.Battery_Install_Hours__c}),
    ISCHANGED({!$Record.Material_Other_Cost__c}),
    ISCHANGED({!$Record.Constructive_Ops_Fee__c}),
    ISCHANGED({!$Record.Permit_Pass_Through_Cost__c}),
    ISCHANGED({!$Record.Adder_Sub_Panel_Price__c}),
    ISCHANGED({!$Record.Adder_Sub_Panel_Qty__c})
  )</expression>
    </formulas>
    <formulas>
        <name>fInputChangedB</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISCHANGED({!$Record.Adder_Flat_Roof_Price__c}),
    ISCHANGED({!$Record.Adder_Flat_Roof_Qty__c}),
    ISCHANGED({!$Record.Adder_Bird_Blocking_Price__c}),
    ISCHANGED({!$Record.Adder_Bird_Blocking_Qty__c}),
    ISCHANGED({!$Record.Adder_Derate_Price__c}),
    ISCHANGED({!$Record.Adder_Derate_Qty__c}),
    ISCHANGED({!$Record.Adder_Structural_Price__c}),
    ISCHANGED({!$Record.Adder_Structural_Qty__c}),
    ISCHANGED({!$Record.Adder_Small_System_10_12_Price__c}),
    ISCHANGED({!$Record.Adder_Small_System_10_12_Qty__c}),
    ISCHANGED({!$Record.Adder_Small_System_13_15_Price__c}),
    ISCHANGED({!$Record.Adder_Small_System_13_15_Qty__c}),
    ISCHANGED({!$Record.Adder_Heat_Detector_Price__c}),
    ISCHANGED({!$Record.Adder_Heat_Detector_Qty__c}),
    ISCHANGED({!$Record.Adder_Conduit_Attic_Price__c}),
    ISCHANGED({!$Record.Adder_Conduit_Attic_Qty__c}),
    ISCHANGED({!$Record.Adder_Roof_Tile_Price__c}),
    ISCHANGED({!$Record.Adder_Roof_Tile_Qty__c}),
    ISCHANGED({!$Record.Adder_Software_Fee_Price__c}),
    ISCHANGED({!$Record.Adder_Software_Fee_Qty__c}),
    ISCHANGED({!$Record.Adder_Upgrade_225_Price__c}),
    ISCHANGED({!$Record.Adder_Upgrade_225_Qty__c}),
    ISCHANGED({!$Record.Adder_Upgrade_400_Price__c}),
    ISCHANGED({!$Record.Adder_Upgrade_400_Qty__c}),
    ISCHANGED({!$Record.NS_Adder_1_Description__c}),
    ISCHANGED({!$Record.NS_Adder_1_Markup_Percent__c}),
    ISCHANGED({!$Record.NS_Adder_1_Material_Cost__c}),
    ISCHANGED({!$Record.NS_Adder_1_Labor_Hours__c}),
    ISCHANGED({!$Record.NS_Adder_2_Description__c}),
    ISCHANGED({!$Record.NS_Adder_2_Markup_Percent__c}),
    ISCHANGED({!$Record.NS_Adder_2_Material_Cost__c}),
    ISCHANGED({!$Record.NS_Adder_2_Labor_Hours__c}),
    ISCHANGED({!$Record.NS_Adder_3_Description__c}),
    ISCHANGED({!$Record.NS_Adder_3_Markup_Percent__c}),
    ISCHANGED({!$Record.NS_Adder_3_Material_Cost__c}),
    ISCHANGED({!$Record.NS_Adder_3_Labor_Hours__c})
  )</expression>
    </formulas>
    <interviewLabel>Sundial Budget Recalc Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sundial Budget Recalc Trigger</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <object>Sundial_Solar__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector><targetReference>Decision_Should_Recalc</targetReference></connector>
    </start>
    <decisions>
        <name>Decision_Should_Recalc</name>
        <label>Should Recalc?</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Recalc</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>fGuardNotWriteback</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fInputChangedA</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fInputChangedB</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Set_Status_Pending</targetReference></connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Set_Status_Pending</name>
        <label>Set Budget_Calc_Status = Pending</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <connector><targetReference>Publish_Recalc_Event</targetReference></connector>
        <inputReference>$Record</inputReference>
        <inputAssignments>
            <field>Budget_Calc_Status__c</field>
            <value><stringValue>Pending</stringValue></value>
        </inputAssignments>
    </recordUpdates>
    <recordCreates>
        <name>Publish_Recalc_Event</name>
        <label>Publish Sundial_Budget_Recalc__e</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <object>Sundial_Budget_Recalc__e</object>
        <inputAssignments>
            <field>Record_Id__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Source__c</field>
            <value><stringValue>FieldTrigger</stringValue></value>
        </inputAssignments>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <status>Draft</status>
</Flow>
