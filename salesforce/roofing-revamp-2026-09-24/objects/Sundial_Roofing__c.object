            </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Lead_Source__c</fullName>
        <description>Layout sheet: lead source. Read-through to the customer hub's Lead_Source__c so it never drifts; edit it on the customer.</description>
        <externalId>false</externalId>
        <formula>TEXT(Sundial_Customer__r.Lead_Source__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lead Source</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
