        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SolarFacts_Account_Id__c</fullName>
        <description>SolarFax's account_id from POST /users (their API), for support lookups.</description>
