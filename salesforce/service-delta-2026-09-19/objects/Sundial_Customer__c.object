<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sundial_Customer__c - the fields added on 2026-09-19 ONLY. package.xml lists them as CustomField members,
  so this file adds them and touches nothing else on the object. NEVER convert this to a
  whole-object deploy.
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Customer_Type__c</fullName>
        <description>Department(s) this customer belongs to. Sales (New Customer) defaults Solar; New Estimate / New Job / the Service Club join set or add Service. Filterable in the tech app's Customers list.</description>
        <externalId>false</externalId>
        <label>Customer Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Solar</fullName>
                    <default>false</default>
                    <label>Solar</label>
                </value>
                <value>
                    <fullName>Roofing</fullName>
                    <default>false</default>
                    <label>Roofing</label>
                </value>
                <value>
                    <fullName>Commercial</fullName>
                    <default>false</default>
                    <label>Commercial</label>
                </value>
                <value>
                    <fullName>Service</fullName>
                    <default>false</default>
                    <label>Service</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
</CustomObject>
