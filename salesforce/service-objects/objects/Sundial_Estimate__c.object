<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sundial_Estimate__c - the quote AND the living bill of work (D-072, docs/service-data-model.md).
  Can exist without a job (proposals); every job has exactly one (Service_Job__c is the 1:1 pair,
  set at conversion). Service Lines hang off THIS object, never the job. Money totals are
  computed by the estimate Lambda on every line write and stored here (D-072.8); the job
  reads them through cross-object formulas. Versions = append-only Version_Log__c JSON + a
  PDF per send (no Version object). Templates are estimates with Is_Template__c and no customer.
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Sundial_Customer__c</fullName>
        <description>Required unless Is_Template__c (templates have no customer; enforced in code - a required lookup would block templates).</description>
        <externalId>false</externalId>
        <label>Sundial Customer</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Customer__c</referenceTo>
        <relationshipLabel>Service Estimates</relationshipLabel>
        <relationshipName>Service_Estimates</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Service_Job__c</fullName>
        <description>The 1:1 pair. Null while the estimate is a proposal with no job; set by Create Job / quick-create. One job per estimate is Lambda-enforced.</description>
        <externalId>false</externalId>
        <label>Service Job</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Service_Job__c</referenceTo>
        <relationshipLabel>Estimates</relationshipLabel>
        <relationshipName>Estimates</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Client__c</fullName>
        <description>Tenant isolation anchor (D-034/D-035). Every Lambda query filters on this.</description>
        <externalId>false</externalId>
        <label>Client</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Tenant__c</referenceTo>
        <relationshipLabel>Service Estimates</relationshipLabel>
        <relationshipName>Sundial_Estimates</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
