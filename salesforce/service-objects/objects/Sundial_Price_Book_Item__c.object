<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sundial_Price_Book_Item__c - the tenant-scoped, VERSIONED price book (D-072.4). NOT the
  standard Pricebook2/Product2 (org-wide, cannot be tenant-isolated). Item_Code__c is the
  stable id shared by every version; exactly one version per code is active (Lambda-enforced).
  'Update' in the portal = clone with the same code, Version+1, old row Is_Active=false and
  Superseded_By set. NEVER deleted (the permission set grants no delete); in-place edit only
  while no Service Line references the version. Lines snapshot price/cost/description anyway.
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Client__c</fullName>
        <description>Tenant isolation anchor (D-034/D-035). Every Lambda query filters on this.</description>
        <externalId>false</externalId>
        <label>Client</label>
        <deleteConstraint>Restrict</deleteConstraint>
        <referenceTo>Sundial_Tenant__c</referenceTo>
        <relationshipLabel>Price Book Items</relationshipLabel>
        <relationshipName>Sundial_Price_Book_Items</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Item_Code__c</fullName>
        <description>Stable line-item ID shared across versions (e.g. SVC-CALL-STD). Office-assigned; migration fills from HCP. External ID for lookup - NOT unique (versions share it).</description>
        <externalId>true</externalId>
        <label>Item Code</label>
        <length>40</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Version__c</fullName>
        <defaultValue>1</defaultValue>
        <description>1, 2, 3... per Item Code.</description>
        <externalId>false</externalId>
        <label>Version</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Portal Price Book list = active only. One active per Item Code.</description>
        <externalId>false</externalId>
        <label>Is Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Superseded_By__c</fullName>
        <description>Set on the old version when Update creates the new one.</description>
        <externalId>false</externalId>
        <label>Superseded By</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Price_Book_Item__c</referenceTo>
        <relationshipLabel>Prior Versions</relationshipLabel>
        <relationshipName>Prior_Versions</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Kind__c</fullName>
        <description>Product = labor + material on one item (both price splits filled). Drives kind-scoped discounts and taxability.</description>
        <externalId>false</externalId>
        <label>Kind</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Labor</fullName>
                    <default>true</default>
                    <label>Labor</label>
                </value>
                <value>
                    <fullName>Material</fullName>
                    <default>false</default>
                    <label>Material</label>
                </value>
                <value>
                    <fullName>Product</fullName>
                    <default>false</default>
                    <label>Product</label>
                </value>
                <value>
                    <fullName>Fee</fullName>
                    <default>false</default>
                    <label>Fee</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Job_Type__c</fullName>
        <description>List-view filter #1 (2026-09-15): which department's work this item is for. Unrestricted so a tenant can add its own.</description>
        <externalId>false</externalId>
        <label>Job Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>false</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Solar</fullName>
                    <default>false</default>
                    <label>Solar</label>
                </value>
                <value>
                    <fullName>Electrical</fullName>
                    <default>false</default>
                    <label>Electrical</label>
                </value>
                <value>
                    <fullName>EV</fullName>
                    <default>false</default>
                    <label>EV</label>
                </value>
                <value>
                    <fullName>Commercial</fullName>
                    <default>false</default>
                    <label>Commercial</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Service_Type__c</fullName>
        <description>List-view filter #2 (2026-09-15): Installation / Repair (+ whatever a tenant adds - unrestricted).</description>
        <externalId>false</externalId>
        <label>Service Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>false</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Installation</fullName>
                    <default>false</default>
                    <label>Installation</label>
                </value>
                <value>
                    <fullName>Repair</fullName>
                    <default>false</default>
                    <label>Repair</label>
                </value>
                <value>
                    <fullName>Maintenance</fullName>
                    <default>false</default>
                    <label>Maintenance</label>
                </value>
                <value>
                    <fullName>Inspection</fullName>
                    <default>false</default>
                    <label>Inspection</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <description>List-view filter #3. GET FROM HARMON: final list, seeded from the HCP export. Unrestricted so the office can add values via the portal admin.</description>
        <externalId>false</externalId>
        <label>Category</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>false</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Service Call</fullName>
                    <default>false</default>
                    <label>Service Call</label>
                </value>
                <value>
                    <fullName>Inverter</fullName>
                    <default>false</default>
                    <label>Inverter</label>
                </value>
                <value>
                    <fullName>Panel</fullName>
                    <default>false</default>
                    <label>Panel</label>
                </value>
                <value>
                    <fullName>Battery</fullName>
                    <default>false</default>
                    <label>Battery</label>
                </value>
                <value>
                    <fullName>EV Charger</fullName>
                    <default>false</default>
                    <label>EV Charger</label>
                </value>
                <value>
                    <fullName>Electrical</fullName>
                    <default>false</default>
                    <label>Electrical</label>
                </value>
                <value>
                    <fullName>Roofing</fullName>
                    <default>false</default>
                    <label>Roofing</label>
                </value>
                <value>
                    <fullName>Inspection</fullName>
                    <default>false</default>
                    <label>Inspection</label>
                </value>
                <value>
                    <fullName>Cleaning</fullName>
                    <default>false</default>
                    <label>Cleaning</label>
                </value>
                <value>
                    <fullName>Service Plan</fullName>
                    <default>false</default>
                    <label>Service Plan</label>
                </value>
                <value>
                    <fullName>Materials</fullName>
                    <default>false</default>
                    <label>Materials</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Customer-facing text printed on estimates/invoices.</description>
        <externalId>false</externalId>
        <label>Description</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Internal_Notes__c</fullName>
        <description>Never printed.</description>
        <externalId>false</externalId>
        <label>Internal Notes</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Unit_of_Measure__c</fullName>
        <externalId>false</externalId>
        <label>Unit of Measure</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Each</fullName>
                    <default>true</default>
                    <label>Each</label>
                </value>
                <value>
                    <fullName>Hour</fullName>
                    <default>false</default>
                    <label>Hour</label>
                </value>
                <value>
                    <fullName>Foot</fullName>
                    <default>false</default>
                    <label>Foot</label>
                </value>
                <value>
                    <fullName>Lot</fullName>
                    <default>false</default>
                    <label>Lot</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Default_Quantity__c</fullName>
        <defaultValue>1</defaultValue>
        <description>e.g. 1.5 hours for the standard service call.</description>
        <externalId>false</externalId>
        <label>Default Quantity</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Estimated_Hours__c</fullName>
        <description>Labor/Product items: default appointment duration when the job is scheduled.</description>
        <externalId>false</externalId>
        <label>Estimated Hours</label>
        <precision>6</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Labor_Cost__c</fullName>
        <description>Internal cost (margin reporting).</description>
        <externalId>false</externalId>
        <label>Labor Cost</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Material_Cost__c</fullName>
        <description>Internal cost.</description>
        <externalId>false</externalId>
        <label>Material Cost</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Labor_Price__c</fullName>
        <description>Sell-side labor portion. Labor items fill only this; Product items fill both.</description>
        <externalId>false</externalId>
        <label>Labor Price</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Material_Price__c</fullName>
        <description>Sell-side material portion.</description>
        <externalId>false</externalId>
        <label>Material Price</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Price__c</fullName>
        <description>Labor Price + Material Price - the one number the grid shows.</description>
        <externalId>false</externalId>
        <label>Price</label>
        <formula>BLANKVALUE(Labor_Price__c,0)+BLANKVALUE(Material_Price__c,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Taxable__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Materials default true; labor per tenant tax config. GET FROM HEATHER: how HCP taxed labor vs materials.</description>
        <externalId>false</externalId>
        <label>Taxable</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>HCP_Id__c</fullName>
        <description>Housecall Pro price-book id (migration key).</description>
        <externalId>true</externalId>
        <label>HCP Id</label>
        <length>64</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Price Book Item</label>
    <nameField>
        <label>Item Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Price Book Items</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <externalSharingModel>Private</externalSharingModel>
</CustomObject>
