    <fields>
        <fullName>First_Scheduled_Start__c</fullName>
        <description>Earliest Service Call Scheduled_Start (roll-up Flow) - list sorting.</description>
        <externalId>false</externalId>
        <label>First Scheduled Start</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Geocode_Lat__c</fullName>
        <description>Service-address geocode, best-effort at intake; feeds geofence + travel hints.</description>
        <externalId>false</externalId>
        <label>Geocode Latitude</label>
        <precision>18</precision>
        <required>false</required>
        <scale>15</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Geocode_Lon__c</fullName>
        <externalId>false</externalId>
        <label>Geocode Longitude</label>
        <precision>18</precision>
        <required>false</required>
        <scale>15</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Geocode_Status__c</fullName>
        <description>Failed/Manual rows fall back to no geofence rather than blocking clock-ins.</description>
        <externalId>false</externalId>
        <label>Geocode Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Geocoded</fullName>
                    <default>false</default>
                    <label>Geocoded</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>Manual</fullName>
                    <default>false</default>
                    <label>Manual</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Street_View_Image_Key__c</fullName>
        <description>S3 key of the street-view still fetched once at geocode time (9/9 ask). Blank = none available.</description>
        <externalId>false</externalId>
        <label>Street View Image Key</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Service Job</label>
    <nameField>
        <displayFormat>SVC-{00000}</displayFormat>
        <label>Job Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Service Jobs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <externalSharingModel>Private</externalSharingModel>
</CustomObject>
