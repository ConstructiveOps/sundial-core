                </value>
                <value>
                    <fullName>Manufacturer</fullName>
                    <default>false</default>
                    <label>Manufacturer</label>
                </value>
                <value>
                    <fullName>Leasing Partner</fullName>
                    <default>false</default>
                    <label>Leasing Partner</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
