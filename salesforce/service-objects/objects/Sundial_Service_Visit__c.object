                    <fullName>Prep</fullName>
                    <default>false</default>
                    <label>Prep</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Client__c</fullName>
        <description>Tenant isolation anchor (D-034/D-035).</description>
        <externalId>false</externalId>
        <label>Client</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Tenant__c</referenceTo>
        <relationshipLabel>Service Calls</relationshipLabel>
        <relationshipName>Sundial_Service_Calls</relationshipName>
