        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Work_Notes__c</fullName>
        <description>Append-only entries auto-stamped user + datetime (Welcome-Call log format; D-065.8). Customer-facing candidates - AI-summarized onto the invoice; authors edit their OWN entries only.</description>
        <externalId>false</externalId>
        <label>Work Notes</label>
        <length>131072</length>
        <trackTrending>false</trackTrending>
