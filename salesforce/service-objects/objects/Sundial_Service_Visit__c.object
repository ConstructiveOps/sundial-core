<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sundial_Service_Visit__c - the Service Call (UI label): one tech x one scheduled
  appointment, with its own clock and GPS (D-065.2 - multi-tech jobs are parallel
  records; D-027 dual-purpose design carries install visit types too).
  The four parent lookups are deliberately NOT required here - the exactly-one rule
  matching Visit_Type__c is enforced by a validation rule / Lambda guard added
  separately, per the schema doc. Time fields are Lambda-written (the PWA has no
  time-edit surface; corrections append to Clock_Intervals__c with actor + reason).
  NOTE: the schema draft's Visit_Number__c is realized as the standard auto-number
  Name field (SC-{00000}) - one number, not two. Draft's Notes__c / Work_Performed__c
  are superseded by the append-only Work_Notes__c / Private_Notes__c pair (D-065.8).
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Visit_Type__c</fullName>
        <description>Drives which parent lookup must be populated and which PWA tab renders the visit (D-027).</description>
        <externalId>false</externalId>
        <label>Visit Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Service</fullName>
                    <default>true</default>
                    <label>Service</label>
                </value>
                <value>
                    <fullName>Solar Install</fullName>
                    <default>false</default>
                    <label>Solar Install</label>
                </value>
                <value>
                    <fullName>Roofing Install</fullName>
                    <default>false</default>
                    <label>Roofing Install</label>
                </value>
                <value>
                    <fullName>Commercial Install</fullName>
                    <default>false</default>
                    <label>Commercial Install</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Sundial_Service__c</fullName>
        <description>Parent ticket - required (via validation) when Visit Type = Service.</description>
        <externalId>false</externalId>
        <label>Service Ticket</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Service__c</referenceTo>
        <relationshipLabel>Service Calls</relationshipLabel>
        <relationshipName>Service_Calls</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sundial_Solar__c</fullName>
        <description>Parent - required (via validation) when Visit Type = Solar Install.</description>
        <externalId>false</externalId>
        <label>Solar Project</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Solar__c</referenceTo>
        <relationshipLabel>Install Visits</relationshipLabel>
        <relationshipName>Install_Visits</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sundial_Roofing__c</fullName>
        <description>Parent - required (via validation) when Visit Type = Roofing Install.</description>
        <externalId>false</externalId>
        <label>Roofing Project</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Roofing__c</referenceTo>
        <relationshipLabel>Install Visits</relationshipLabel>
        <relationshipName>Install_Visits</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sundial_Commercial__c</fullName>
        <description>Parent - required (via validation) when Visit Type = Commercial Install. REMOVE from package.xml if Sundial_Commercial__c does not exist in the org.</description>
        <externalId>false</externalId>
        <label>Commercial Project</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_Commercial__c</referenceTo>
        <relationshipLabel>Install Visits</relationshipLabel>
        <relationshipName>Install_Visits</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Tech__c</fullName>
        <description>ONE tech per Service Call. A multi-tech job is parallel records under the same ticket, each with its own clock (D-065.2).</description>
        <externalId>false</externalId>
        <label>Tech</label>
        <deleteConstraint>SetNull</deleteConstraint>
        <referenceTo>Sundial_User__c</referenceTo>
