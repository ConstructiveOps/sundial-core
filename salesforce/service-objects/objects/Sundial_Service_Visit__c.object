    </fields>
    <fields>
        <fullName>Geofence_Verified__c</fullName>
        <defaultValue>false</defaultValue>
        <description>All clock events within the per-tenant radius of the service address OR the shop. TAG, not blocker - out-of-fence events are flagged, never refused (D-065.10).</description>
        <externalId>false</externalId>
        <label>Geofence Verified</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Bill_To_Type__c</fullName>
        <description>OVERRIDE of the ticket's billing default for this visit (blank = inherit). Visit 1 to the customer, visit 2 to the manufacturer (RMA) is a real pattern.</description>
        <externalId>false</externalId>
        <label>Bill To Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
