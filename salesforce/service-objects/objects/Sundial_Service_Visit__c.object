    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>En Route = 'on my way' (texts the customer when notify is on; ends the PREVIOUS visit's clock and starts drive time on this one - matches how techs are paid).</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Scheduled</fullName>
                    <default>true</default>
                    <label>Scheduled</label>
                </value>
                <value>
                    <fullName>En Route</fullName>
                    <default>false</default>
                    <label>En Route</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Complete</fullName>
                    <default>false</default>
                    <label>Complete</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>No-Show</fullName>
                    <default>false</default>
                    <label>No-Show</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Actual_Start__c</fullName>
        <description>FIRST clock-in (Lambda-set from the field sync; device tap-time, not sync-time).</description>
        <externalId>false</externalId>
        <label>Actual Start</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Actual_End__c</fullName>
        <description>LAST clock-out. Re-clock-in on the same visit reopens it (interval appends).</description>
        <externalId>false</externalId>
        <label>Actual End</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Duration_Minutes__c</fullName>
        <description>Sum of the intervals in Clock Intervals - NOT end minus start (lunch/parts-run gaps excluded). Feeds payroll AND billing.</description>
        <externalId>false</externalId>
        <label>Duration Minutes</label>
        <precision>9</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Clock_Intervals__c</fullName>
        <description>Append-only JSON interval log, Lambda-written: [{in, out, in_gps, out_gps, source}]. Office/manager corrections APPEND with actor + reason; the PWA has no time-edit surface (D-065.10).</description>
        <externalId>false</externalId>
        <label>Clock Intervals</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Clock_In_Latitude__c</fullName>
        <description>GPS at first clock-in (null when no fix - never blocks the clock event).</description>
