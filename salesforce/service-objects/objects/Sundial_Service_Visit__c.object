        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Private_Notes__c</fullName>
        <description>Internal-only entries, same append-only stamped format. Never merges anywhere customer-visible.</description>
        <externalId>false</externalId>
        <label>Private Notes</label>
        <length>131072</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Install_Milestones_Completed__c</fullName>
        <description>Install visit types only; hidden on Service.</description>
        <externalId>false</externalId>
        <label>Install Milestones Completed</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Checklist_Template_Key__c</fullName>
        <description>Per-tenant config key assigned at scheduling (e.g. inverter-rma). Templates live in tenant config, not Salesforce objects (D-065.9).</description>
        <externalId>false</externalId>
        <label>Checklist Template Key</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Checklist_State__c</fullName>
        <description>Item completion snapshot (JSON). Required items gate Complete and gate En Route to the next visit.</description>
        <externalId>false</externalId>
        <label>Checklist State</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Photos_Count__c</fullName>
        <description>Count of files at SUNDIAL/{visitId}/ (metadata-derived).</description>
        <externalId>false</externalId>
        <label>Photos Count</label>
        <precision>4</precision>
