<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sundial_Service__c - the Service Ticket (Phase 2, D-065).
  One record per customer issue: intake, triage, estimate states, billing default,
  Flow-maintained roll-ups. Field source of record: docs/Sundial_Service_Fields_by_Section.xlsx
  + docs/service-workflows.md. NEW OBJECT: OWD Private per the sharing architecture.
  NOTE the Bill To picklist value "Internal Warranty" - deliberately tenant-neutral
  (never "Harmon Warranty"; picklist values are shared org-wide across tenants).
  Run scripts/verify-service-schema.mjs BEFORE deploying (drop
  Originating_Commercial_Project__c from package.xml if Sundial_Commercial__c is absent).
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Sundial_Customer__c</fullName>
