<?xml version="1.0" encoding="UTF-8"?>
<!--
  v9 DEALER TERMS (D-085) - Sundial_Customer__c.
  MODIFIES Commission_Redline_PPW__c (replaces v8) and Sales_Rep_Name__c; ADDS Dealer_Display_Name__c.
  Commission_Redline_PPW__c carries every v8 attribute except <formula> and <description>.
  GENERATED by generate.mjs - edit that, not this file.
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Commission_Redline_PPW__c</fullName>
        <description>D19 redline, amended D36 and D-085 (2026-10-22). Chosen by the Customer's CreatedDate. BEFORE 2026-09-04 the legacy rule: INTERNAL when Sales_Company__c = &quot;Harmon Solar&quot;, EXTERNAL otherwise; Lightreach when Financing_Partner__c = &quot;Lightreach&quot;. Legacy rates (unchanged): Internal+Lightreach 2.10, Internal+other 2.20, External+Lightreach 1.75, External+other 1.85. Blank Sales_Company__c =&gt; NULL. ON/AFTER 2026-09-04 the DEALER's terms: Dealer__r.Redline_LightReach_PPW__c when Lightreach, else Dealer__r.Redline_PPW__c; the picklists are not read. No Dealer__c, or a blank dealer rate =&gt; NULL, never a default. Dealer__c comes from the sales rep (D-064 A1). The Solar twin reads THIS field for deals on/after the cutoff. Sales_Type_Partner__c on this object is a placeholder and must not be used.</description>
        <externalId>false</externalId>
        <formula>IF(DATEVALUE(CreatedDate)&lt;DATE(2026,9,4),IF(ISBLANK(TEXT(Sales_Company__c)),NULL,IF(TEXT(Sales_Company__c)=&quot;Harmon Solar&quot;,IF(TEXT(Financing_Partner__c)=&quot;Lightreach&quot;,2.10,2.20),IF(TEXT(Financing_Partner__c)=&quot;Lightreach&quot;,1.75,1.85))),IF(ISBLANK(Dealer__c),NULL,IF(TEXT(Financing_Partner__c)=&quot;Lightreach&quot;,Dealer__r.Redline_LightReach_PPW__c,Dealer__r.Redline_PPW__c)))</formula>
        <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
        <inlineHelpText>The $/W redline used to work out commission. Blank if the sales company is not set.</inlineHelpText>
        <label>Commission Redline $/W</label>
        <precision>18</precision>
        <required>false</required>
        <scale>4</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Sales_Rep_Name__c</fullName>
        <description>D-085. The rep's name for display and the Sales page's rep filter: the Sales_Rep__c lookup's First + Last when set; else the legacy Sunbase_Sales_Rep__c; else the legacy Dealer_Name__c. Display only - ownership and access key on Sales_Rep__c / Dealer__c, never on this text.</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Sales_Rep__c)),Sales_Rep__r.First_Name__c  + &quot; &quot; +  Sales_Rep__r.Last_Name__c,IF(NOT(ISBLANK(TEXT(Sunbase_Sales_Rep__c))),TEXT(Sunbase_Sales_Rep__c),TEXT(Dealer_Name__c)))</formula>
        <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
        <label>Sales Rep Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Dealer_Display_Name__c</fullName>
        <description>D-085. The name of this deal's Dealer__c, which the server sets from the sales rep (D-064 A1). Blank when no dealer is set. Shown beside the legacy sales-company picklist, which is read only for deals created before 2026-09-04.</description>
        <externalId>false</externalId>
        <formula>Dealer__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
        <inlineHelpText>The dealer that owns this deal, from its sales rep. Blank until a rep with a dealer is assigned.</inlineHelpText>
        <label>Dealer (based on Sales Rep)</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
