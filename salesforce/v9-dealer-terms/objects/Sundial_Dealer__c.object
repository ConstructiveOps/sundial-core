<?xml version="1.0" encoding="UTF-8"?>
<!--
  v9 DEALER TERMS (D-085) - Sundial_Dealer__c.
  4 NEW fields - the dealer's commercial terms (redlines, Acumatica vendor). Additive.
  GENERATED by generate.mjs - edit that, not this file.
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Redline_PPW__c</fullName>
        <description>D-085. This dealer's commission redline in $/W for every financing partner EXCEPT LightReach. Read by Commission_Redline_PPW__c on Sundial_Customer__c (and through it on Sundial_Solar__c) for deals whose Customer was created on/after 2026-09-04; earlier deals keep the legacy sales-company rates. BLANK means no redline: the deal's redline and commission total are blank, never a default. Seeded by scripts/backfill-dealer-terms.mjs (Harmon Solar 2.20, Invictus Energy 1.75, everyone else 1.85).</description>
        <externalId>false</externalId>
        <inlineHelpText>Commission redline for every financing partner except LightReach.</inlineHelpText>
        <label>Redline $/W</label>
        <precision>18</precision>
        <required>false</required>
        <scale>4</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Redline_LightReach_PPW__c</fullName>
        <description>D-085. This dealer's commission redline in $/W for LightReach-financed deals (Customer Financing_Partner__c = &quot;Lightreach&quot;). Same reach and blank rule as Redline_PPW__c. Seeded by scripts/backfill-dealer-terms.mjs (Harmon Solar 2.10, Invictus Energy 1.65, everyone else 1.65).</description>
        <externalId>false</externalId>
        <label>Redline $/W (LightReach)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>4</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Acumatica_Vendor_ID__c</fullName>
        <description>D-085. The Acumatica VendorID this dealer's commission POs are raised against. Set by Constructive Ops once Harmon finance creates the vendor; seeded from docs/integrations/dealer-vendor-map.csv by scripts/backfill-dealer-terms.mjs. Blank = no vendor yet: a PO must fail loudly rather than guess (D4). Not yet read by sundial-acumatica-commission-po, which still resolves the vendor from the Solar sales-company picklist through the CSV.</description>
        <externalId>false</externalId>
        <inlineHelpText>The vendor the commission POs are raised against. Set by Constructive Ops once Harmon finance creates the vendor.</inlineHelpText>
        <label>Acumatica Vendor ID</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Acumatica_Vendor_Name__c</fullName>
        <description>D-085. The Acumatica vendor's name, for a human checking the vendor ID is the right company. Informational only; nothing reads it.</description>
        <externalId>false</externalId>
        <label>Acumatica Vendor Name</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
